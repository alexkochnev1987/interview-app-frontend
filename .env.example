    # Copy to ".env.local" for local development (never commit secrets).

NEXT_PUBLIC_ENV=local

# Active UI theme preset (innowise | red | blue | purple)
NEXT_PUBLIC_APP_THEME=innowise
APP_THEME=innowise

# Default UI theme mode (system | light | dark)
DEFAULT_THEME_MODE=system

# Enable Herman (recruiter AI assistant) widget (true | false)
RECRUITER_ASSISTANT_ENABLED=true

# Used by next.config.js rewrites: browser calls /api/* → this backend origin.
BACKEND_URL=http://localhost:3000

# E2E (Playwright) — optional overrides.
# E2E_BASE_URL=http://localhost:3001
# E2E_MOCK_API_PORT=3000  # Mock API listen port + health URL. BACKEND_URL above wins if set.
