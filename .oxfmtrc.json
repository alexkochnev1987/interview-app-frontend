{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "arrowParens": "always",
  "bracketSpacing": true,
  "ignorePatterns": [
    ".next",
    ".next-dev",
    "out",
    "build",
    "next-env.d.ts",
    "src/lib/api-types.ts"
  ]
}
